# ═══════════════════════════════════════════════════════════════
#  Modèle .env — copier ce fichier en .env et remplir les valeurs
#  NE JAMAIS committer le .env réel dans Git !
# ═══════════════════════════════════════════════════════════════

# ─── Django core (OBLIGATOIRE) ───
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire

# DEBUG : True en dev, False en production (obligatoire)
DJANGO_DEBUG=False

# Hôtes autorisés (séparés par virgules, jamais *)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sanar.app,www.sanar.app

# ─── Base de données PostgreSQL ───
DB_NAME=sanar
DB_USER=sanar_user
DB_PASSWORD=remplacer-par-mdp-db
DB_HOST=localhost
DB_PORT=5432

# ─── Chiffrement au repos (OBLIGATOIRE en production) ───
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_ENCRYPTION_KEY=remplacer-par-cle-fernet-base64

# ─── Twilio SMS (optionnel — télécommunications) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Firebase Cloud Messaging (optionnel — notifications push) ───
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ─── WhatsApp Business API (optionnel) ───
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Redis (Celery + Django Channels) ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Celery ───
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Sentry (monitoring erreurs, optionnel) ───
SENTRY_DSN=

# ─── Google Calendar OAuth2 (synchro médecin, optionnel) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://sanar.app/api/calendar/callback/
